Package: climwin
Type: Package
Title: Climate Window Analysis
Version: 2.0
Authors@R: c(person(given = c("Liam", "D."), family = "Bailey",
                        role = c("aut", "cre"),
                        email = "liam.bailey@liamdbailey.com"),
                 person(given = "Martijn",
